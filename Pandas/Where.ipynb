   ],
   "source": [
    "data = {\n",
    "    'Name': ['Ravi', 'Aman', 'Neha', 'Simran'],\n",
    "    'Marks': [45, 80, 30, 90]\n",
    "}\n",
    "\n",
    "df = pd.DataFrame(data)\n",
    "\n",
    "print(\"Original Data:\\n\")\n",
    "print(df)\n",
    "\n",
    "print(\"\\nAfter where():\\n\")\n",
    "\n",
    "result = df.where(df['Marks'] >= 50)\n",
    "\n",
    "print(result)"
   ]
